`timescale 1ns / 1ps

module cpu_SC;

reg clk;
reg reset;

wire [31:0] pc_out;
wire [31:0] pc_plus4;
wire [31:0] pc_target;
wire [31:0] pc_next;
wire [31:0] instruction;

wire RegWrite;
wire ALUSrc;
wire MemWrite;
wire MemRead;
wire MemToReg;
wire Branch;
wire BranchType;
wire Jump;
wire [3:0] ALUOp;
wire [1:0] ImmSel;

wire [4:0] rs1;
wire [4:0] rs2;
wire [4:0] rd;

wire [31:0] rdata1;
wire [31:0] rdata2;
wire [31:0] immOut;
wire [31:0] aluB;
wire [31:0] aluResult;
wire zero;

wire [31:0] memReadData;
wire [31:0] writeBackData;

wire equal;
wire branch_taken;

assign rs1 = instruction[19:15];
assign rs2 = instruction[24:20];
assign rd  = instruction[11:7];

reg32 PC (
    .clk(clk),
    .reset(reset),
    .we(1'b1),
    .d(pc_next),
    .q(pc_out)
);

PCInc pc_inc (
    .oldPC(pc_out),
    .newPC(pc_plus4)
);

assign pc_target = pc_out + immOut;

assign equal = (rdata1 == rdata2);

assign branch_taken = Branch &&
                     ((BranchType == 1'b0 && equal) ||
                      (BranchType == 1'b1 && !equal));

assign pc_next = (Jump || branch_taken) ? pc_target : pc_plus4;

BankedMEM IMEM (
    .clk(clk),
    .writeEn(1'b0),
    .address(pc_out),
    .writeData(32'b0),
    .readData(instruction)
);

ControlUnit cu (
    .instruction(instruction),
    .RegWrite(RegWrite),
    .ALUSrc(ALUSrc),
    .MemWrite(MemWrite),
    .MemRead(MemRead),
    .MemToReg(MemToReg),
    .Branch(Branch),
    .BranchType(BranchType),
    .Jump(Jump),
    .ALUOp(ALUOp),
    .ImmSel(ImmSel)
);

reg_file rf (
    .clk(clk),
    .reset(reset),
    .reg_write_en(RegWrite),
    .rs1(rs1),
    .rs2(rs2),
    .rd(rd),
    .wdata(writeBackData),
    .rdata1(rdata1),
    .rdata2(rdata2)
);

immGen ig (
    .immSel(ImmSel),
    .instruction(instruction),
    .immOut(immOut)
);

assign aluB = ALUSrc ? immOut : rdata2;

rv32ialu alu (
    .A(rdata1),
    .B(aluB),
    .ctrl(ALUOp),
    .Y(aluResult),
    .zero(zero)
);

BankedMEM DMEM (
    .clk(clk),
    .writeEn(MemWrite),
    .address(aluResult),
    .writeData(rdata2),
    .readData(memReadData)
);

assign writeBackData = Jump ? pc_plus4 :
                       MemToReg ? memReadData :
                                  aluResult;

endmodule
