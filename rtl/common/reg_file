`timescale 1ns / 1ps

module reg_file(
    input clk,
    input reset,
    input reg_write_en,
    input [4:0] rs1,
    input [4:0] rs2,
    input [4:0] rd,
    input [31:0] wdata,
    output [31:0] rdata1,
    output [31:0] rdata2
);

wire [31:0] dec_out;
wire [31:0] reg_out [0:31];

decoder5to32 dec (
    .rd(rd),
    .reg_we(reg_write_en),
    .out(dec_out)
);

// x0 hardwired to zero
assign reg_out[0] = 32'b0;

genvar i;
generate
    for (i = 1; i < 32; i = i + 1) begin : reg_loop
        reg32 r (
            .clk(clk),
            .reset(reset),
            .we(dec_out[i]),
            .d(wdata),
            .q(reg_out[i])
        );
    end
endgenerate

assign #1 rdata1 = reg_out[rs1];
assign #1 rdata2 = reg_out[rs2];

endmodule
