`timescale 1ns / 1ps

module alu_ctrl(
    input  [2:0] funct3,
    input  [6:0] funct7,
    output reg [2:0] alu_ctrl
);

always @(*) begin
    case (funct3)
        3'b000: begin
            if (funct7[5])
                alu_ctrl = #1 3'b000;   // SUB
            else
                alu_ctrl = #1 3'b001;   // ADD
        end

        3'b111: alu_ctrl = #1 3'b010;   // AND
        3'b110: alu_ctrl = #1 3'b011;   // OR
        3'b001: alu_ctrl = #1 3'b100;   // SLL
        3'b010: alu_ctrl = #1 3'b110;   // SLT

        default: alu_ctrl = #1 3'b111;  // Reserved
    endcase
end

endmodule
