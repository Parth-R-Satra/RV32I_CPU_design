`timescale 1ns / 1ps

module ControlUnit(
    input  [31:0] instruction,
    output reg RegWrite,
    output reg ALUSrc,
    output reg MemWrite,
    output reg MemRead,
    output reg MemToReg,
    output reg Branch,
    output reg BranchType,   // 0 = BEQ, 1 = BNE
    output reg Jump,
    output reg [3:0] ALUOp,
    output reg [1:0] ImmSel
);

wire [6:0] opcode;
wire [2:0] funct3;
wire [6:0] funct7;

assign opcode = instruction[6:0];
assign funct3 = instruction[14:12];
assign funct7 = instruction[31:25];

always @(*) begin
    RegWrite   = 1'b0;
    ALUSrc     = 1'b0;
    MemWrite   = 1'b0;
    MemRead    = 1'b0;
    MemToReg   = 1'b0;
    Branch     = 1'b0;
    BranchType = 1'b0;
    Jump       = 1'b0;
    ALUOp      = 4'b1111;
    ImmSel     = 2'b00;

    case (opcode)

        7'b0110011: begin // R-type
            RegWrite = 1'b1;
            ALUSrc   = 1'b0;

            case (funct3)
                3'b000: ALUOp = funct7[5] ? 4'b0000 : 4'b0001; // SUB / ADD
                3'b111: ALUOp = 4'b0010; // AND
                3'b110: ALUOp = 4'b0011; // OR
                3'b001: ALUOp = 4'b0100; // SLL
                3'b101: ALUOp = 4'b0101; // SRL
                3'b010: ALUOp = 4'b0110; // SLT
                3'b100: ALUOp = 4'b0111; // XOR
                default: ALUOp = 4'b1111;
            endcase
        end

        7'b0010011: begin // I-type
            RegWrite = 1'b1;
            ALUSrc   = 1'b1;
            ImmSel   = 2'b00;

            case (funct3)
                3'b000: ALUOp = 4'b0001; // ADDI
                3'b111: ALUOp = 4'b0010; // ANDI
                3'b100: ALUOp = 4'b0111; // XORI
                default: ALUOp = 4'b1111;
            endcase
        end

        7'b0000011: begin // LW
            RegWrite = 1'b1;
            ALUSrc   = 1'b1;
            MemRead  = 1'b1;
            MemToReg = 1'b1;
            ALUOp    = 4'b0001; // ADD address
            ImmSel   = 2'b00;
        end

        7'b0100011: begin // SW
            ALUSrc   = 1'b1;
            MemWrite = 1'b1;
            ALUOp    = 4'b0001; // ADD address
            ImmSel   = 2'b01;
        end

        7'b1100011: begin // BEQ / BNE
            Branch = 1'b1;
            ImmSel = 2'b10;

            case (funct3)
                3'b000: BranchType = 1'b0; // BEQ
                3'b001: BranchType = 1'b1; // BNE
                default: BranchType = 1'b0;
            endcase
        end

        7'b1101111: begin // JAL
            RegWrite = 1'b1;
            Jump     = 1'b1;
            ImmSel   = 2'b11;
        end

        default: begin
            RegWrite   = 1'b0;
            ALUSrc     = 1'b0;
            MemWrite   = 1'b0;
            MemRead    = 1'b0;
            MemToReg   = 1'b0;
            Branch     = 1'b0;
            BranchType = 1'b0;
            Jump       = 1'b0;
            ALUOp      = 4'b1111;
            ImmSel     = 2'b00;
        end

    endcase
end

endmodule
